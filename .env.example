# Переменные окружения JanDós

# JWT секрет — обязательно замените на случайную строку в продакшне
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Время жизни JWT токена
JWT_EXPIRES_IN=24h

# Порт сервера
PORT=3000

# Размер загружаемых файлов (в байтах, 5MB по умолчанию)
MAX_FILE_SIZE=5242880

# API ключ Gemini (если используется AI-помощник)
GEMINI_API_KEY=your_gemini_api_key_here

# Режим работы (development / production)
NODE_ENV=development
